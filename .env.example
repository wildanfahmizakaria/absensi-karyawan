# Konfigurasi Lingkungan Sistem Absensi CV Mandala Mahardika (SOT v0.2)

# URL Endpoint REST API Backend (misal Laravel / Express / FastAPI)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mode Adapter:
# 'true'  -> Menggunakan adapter simulasi lokal (Mock Data + Local Storage persisten)
# 'false' -> Mengirim permintaan HTTP nyata ke VITE_API_BASE_URL
VITE_USE_MOCK_ADAPTER=true

# Nama Aplikasi & Versi Brand
VITE_APP_NAME="Sistem Absensi CV Mandala Mahardika"
VITE_APP_VERSION="1.0.0"
