# Konfigurasi REST API Backend Produksi CV Mandala Mahardika (SOT v1.0.0)
VITE_API_BASE_URL=https://absensi-karyawan-backend-production.up.railway.app/api/v1

# Mode Adapter:
# 'false' -> Mengirim permintaan HTTP nyata ke VITE_API_BASE_URL (Produksi)
# 'true'  -> Menggunakan adapter simulasi lokal
VITE_USE_MOCK_ADAPTER=false

# Nama Aplikasi & Versi Brand
VITE_APP_NAME="Sistem Absensi CV Mandala Mahardika"
VITE_APP_VERSION="1.0.0"
